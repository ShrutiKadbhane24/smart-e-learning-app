<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_no_record"
            android:text="No Record"
            android:visibility="gone"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@color/light_purple"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">

                <ImageView
                    android:id="@+id/img_my_profile"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="10dp"
                    android:src="@drawable/profileimage"
                    android:elevation="1dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_my_profile_change_profile_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="32dp"
                    android:background="@drawable/btn_bg_shape"
                    android:layout_below="@id/img_my_profile"
                    android:textColor="@color/white"
                    android:text="Change Profile Photo"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="85dp"
                        app:contentPaddingTop="15dp"
                        app:contentPaddingBottom="15dp"
                        app:contentPaddingLeft="15dp"
                        app:contentPaddingRight="15dp"
                        app:cardCornerRadius="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="120dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_name_title"
                                    android:text="Name:- "
                                    android:textColor="@color/purple_700"
                                    android:textSize="16dp"
                                    android:layout_marginLeft="10dp"
                                    android:textAlignment="textStart"
                                    android:layout_marginTop="20dp"
                                    android:gravity="start"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-condensed-medium"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_name"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="sans-serif-condensed-light"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_mobile_no_title"
                                    android:text="Mobile Number:- "
                                    android:textColor="@color/purple_700"
                                    android:textSize="16dp"
                                    android:layout_marginLeft="10dp"
                                    android:textAlignment="textStart"
                                    android:layout_marginTop="20dp"
                                    android:gravity="start"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-condensed-medium"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_mobile_no"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="sans-serif-condensed-light"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_email_id_title"
                                    android:text="Email Id:- "
                                    android:textColor="@color/purple_700"
                                    android:textSize="16dp"
                                    android:layout_marginLeft="10dp"
                                    android:textAlignment="textStart"
                                    android:layout_marginTop="20dp"
                                    android:gravity="start"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-condensed-medium"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_email_id"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="sans-serif-condensed-light"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_age_title"
                                    android:text="Age:- "
                                    android:textColor="@color/purple_700"
                                    android:textSize="16dp"
                                    android:layout_marginLeft="10dp"
                                    android:textAlignment="textStart"
                                    android:layout_marginTop="20dp"
                                    android:gravity="start"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-condensed-medium"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_age"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="sans-serif-condensed-light"/>

                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_child_address_title"
                                    android:text="Address:- "
                                    android:textColor="@color/purple_700"
                                    android:textSize="16dp"
                                    android:layout_marginLeft="10dp"
                                    android:textAlignment="textStart"
                                    android:layout_marginTop="20dp"
                                    android:gravity="start"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-condensed-medium"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_address"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="sans-serif-condensed-light"/>

                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_username_title"
                                    android:text="Username:- "
                                    android:textColor="@color/purple_700"
                                    android:textSize="16dp"
                                    android:layout_marginLeft="10dp"
                                    android:textAlignment="textStart"
                                    android:layout_marginTop="20dp"
                                    android:gravity="start"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-condensed-medium"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/txt_profile_username"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="sans-serif-condensed-light"/>

                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_my_profile_update_profile"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="32dp"
                                android:layout_marginTop="15dp"
                                android:layout_marginEnd="32dp"
                                android:background="@drawable/btn_bg_shape"
                                android:textColor="@color/white"
                                android:text="Update Profile"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </RelativeLayout>
        </LinearLayout>

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/progress"
            android:layout_centerInParent="true"
            android:visibility="gone"
            />

    </RelativeLayout>

</ScrollView>